APP_NAME="webhook-hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=webhooks
DB_USERNAME=webhooks
DB_PASSWORD=webhooks

QUEUE_CONNECTION=database
SESSION_DRIVER=database
CACHE_STORE=database

WEBHOOK_TELEPHONY_SECRET=telephony-secret
WEBHOOK_MESSENGER_SECRET=messenger-secret
WEBHOOK_EMAIL_SECRET=email-secret

WEBHOOK_RATE_LIMIT=60
